# ============================================
# Wapsell Production Environment Configuration
# ============================================
# This file is a TEMPLATE.
# Copy to .env.production and fill in actual values.
# DO NOT commit .env.production to version control.
#
# For secrets (API keys, tokens), use:
# - Hetzner environment variables
# - Docker secrets (if using swarm)
# - Environment variable injection at deployment

# ===== PERFORMANCE & MONITORING =====

# Disable Next.js telemetry (reduce build overhead)
NEXT_TELEMETRY_DISABLED=1

# Node.js environment
NODE_ENV=production

# ===== INTERNATIONALIZATION =====

# Supported locales (default: es, en)
NEXT_PUBLIC_I18N_LOCALES=es,en
NEXT_PUBLIC_I18N_DEFAULT_LOCALE=es

# ===== BRAND & DOMAIN =====

# Domain for canonical URLs and metadata
NEXT_PUBLIC_DOMAIN=wapsell.example.com
NEXT_PUBLIC_BRAND_NAME=Wapsell

# ===== ANALYTICS & TRACKING =====

# If using external analytics, add endpoint here
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# ===== SECURITY =====

# CORS and security headers are configured in next.config.js headers()
# Set these in Hetzner environment if needed:
# - ALLOWED_ORIGINS
# - API_KEY_BACKEND
# - COOKIE_SECRET

# ===== OPTIONAL: REDIS CACHING (if used) =====

# Uncomment if implementing Redis cache handler for ISR
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_password

# ===== BUILD OPTIMIZATION FLAGS =====

# These are automatically set but documented here:
# NEXT_BUILD_ID - Auto-generated, enables atomic deployments
# NEXT_STATIC_GENERATION_RETENTION=300 - Keep 5 min of static pages
